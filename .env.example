# ==============================================================================
# Ariadne Environment Configuration
# ==============================================================================

# FalkorDB Connection (Works seamlessly with FalkorDB Cloud OR local Docker)
# For FalkorDB Cloud: e.g., your-db-id.cloud.falkordb.com
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Multi-Model Investigation Cluster API Keys (Free Tiers)
# 1. Groq (Get free key at https://console.groq.com)
GROQ_API_KEY=

# 2. NVIDIA NIM (1,000 free credits at https://build.nvidia.com)
NVIDIA_NIM_API_KEY=

# 3. Hugging Face Serverless (Free token at https://huggingface.co/settings/tokens)
HF_TOKEN=

# Stigmergic Trail Parameters
TRAIL_DECAY_LAMBDA=0.005
TRAIL_INITIAL_WEIGHT=1.0

# Tenant Configuration
DEFAULT_TENANT_ID=tenant_default
EVAL_TRUTH_GRAPH=eval_truth
SHARED_PATTERNS_GRAPH=shared_patterns

# Server Configuration
PORT=8000
HOST=0.0.0.0
